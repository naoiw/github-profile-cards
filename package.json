{
  "name": "github-profile-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "generate": "node src/cli.ts",
    "demo": "node src/cli.ts --demo --output-dir demo-output",
    "test": "node --test tests/*.test.ts",
    "check": "node --check src/github.ts && node --check src/core.ts && node --check src/cli.ts",
    "gallery": "node scripts/gallery.ts",
    "gallery:check": "node scripts/gallery.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
